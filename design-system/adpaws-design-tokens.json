{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "AdPaws",
  "version": "1.0.0",
  "description": "Design tokens de AdPaws. Fuente de verdad: src/index.css + src/tailwind.config.ts",
  "typography": {
