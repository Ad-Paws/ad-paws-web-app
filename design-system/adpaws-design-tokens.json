      "mutedForeground": "#dce8dc",
      "destructive": "#ed8383",
      "destructiveForeground": "#121613",
      "info": "#c5daef",
      "infoForeground": "#121613",
      "border": "#202720",
      "input": "#202720",
      "ring": "#80af80",
      "badge": {
        "success": "#1e3a1e",
        "successForeground": "#a4c0a4",
